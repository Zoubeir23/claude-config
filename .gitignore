# Whitelist: ignore everything, then allow only portable config
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/settings.example.json
!/rules/
!/agents/
!/commands/
!/contexts/
!/examples/
!/agent-memory/
!/song/
!/skills/
!/skills-lock.json
!/package-manager.json
!/.agents/
!/scripts/
!/plugins/
/plugins/*
!/plugins/installed_plugins.json
!/plugins/known_marketplaces.json
!/projects/
/projects/*
!/projects/-Users-zoubeir--claude/
/projects/-Users-zoubeir--claude/*
!/projects/-Users-zoubeir--claude/memory/

# Never
node_modules/
.env
.env.*
*.key
*.pem
.DS_Store
**/.git/
/skills/synced/
/skills/suggest-designs/
/agent-memory/
